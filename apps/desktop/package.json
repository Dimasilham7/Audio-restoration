{
  "name": "@audiorestorer/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AudioRestorer AI desktop shell",
  "author": "AudioRestorer AI",
  "main": "./out/main/index.js",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "electron-vite build && electron-builder --config electron-builder.yml --win",
    "pack": "electron-vite build && electron-builder --config electron-builder.yml --win --dir"
  },
  "build": {
    "appId": "com.audiorestorer.ai",
    "productName": "AudioRestorer AI"
  },
  "dependencies": {
    "@audiorestorer/contracts": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.17.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  }
}
